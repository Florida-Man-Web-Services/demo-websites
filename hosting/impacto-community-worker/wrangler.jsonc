{
  "name": "impacto-community",
  "main": "src/index.js",
  "compatibility_date": "2026-09-10",
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "vars": {
    "ORIGIN_BASE": "https://floridamanweb.online/vanity/impacto"
  },
  "routes": [
    { "pattern": "impacto.community/*", "zone_name": "impacto.community" },
    { "pattern": "www.impacto.community/*", "zone_name": "impacto.community" }
  ]
}
