{
  "name": "xerxes-vanity",
  "main": "src/index.js",
  "compatibility_date": "2026-09-10",
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "vars": {
    "ORIGIN_BASE": "https://floridamanweb.online/vanity/khashayar-mahmoudi"
  },
  "routes": [
    { "pattern": "xerxesofgainesville.com/*", "zone_name": "xerxesofgainesville.com" },
    { "pattern": "www.xerxesofgainesville.com/*", "zone_name": "xerxesofgainesville.com" }
  ]
}
