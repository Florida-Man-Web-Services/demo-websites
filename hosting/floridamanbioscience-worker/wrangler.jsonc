{
  "name": "floridamanbioscience",
  "main": "src/index.js",
  "compatibility_date": "2026-09-11",
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "vars": {
    "ORIGIN_BASE": "https://flmanbiosci.net"
  },
  "routes": [
    { "pattern": "floridamanbioscience.com/*", "zone_name": "floridamanbioscience.com" },
    { "pattern": "www.floridamanbioscience.com/*", "zone_name": "floridamanbioscience.com" }
  ]
}
